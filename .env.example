# Local dummy credentials for the synthetic source database.
# These are not secrets. Do not reuse them for any real system.
LAKEFORGE_POSTGRES_HOST=localhost
LAKEFORGE_POSTGRES_PORT=54329
LAKEFORGE_POSTGRES_DB=lakeforge
LAKEFORGE_POSTGRES_USER=lakeforge
LAKEFORGE_POSTGRES_PASSWORD=lakeforge
LAKEFORGE_LANDING_DIR=data/landing
LAKEFORGE_BRONZE_DIR=data/bronze
LAKEFORGE_SILVER_DIR=data/silver
LAKEFORGE_GOLD_DIR=data/gold
LAKEFORGE_LOG_LEVEL=INFO
LAKEFORGE_SEED=42
LAKEFORGE_PROFILE=dev
# Optional size overrides. Leave unset so the selected profile supplies them.
# LAKEFORGE_VEHICLE_COUNT=
# LAKEFORGE_HOURS=
# LAKEFORGE_INTERVAL_MINUTES=
LAKEFORGE_ANOMALIES=true
